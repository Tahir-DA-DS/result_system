# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/brighthills?retryWrites=true&w=majority
# Long random text, 32+ characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Your frontend address(es), comma separated. No trailing slash.
FRONTEND_URL=http://localhost:5173
# Only used once, to create the first admin when the database has no users. Change the password after first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
